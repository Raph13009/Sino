# Public canonical origin used in documentation. The application hardcodes
# https://www.opopa-partners.com for canonicals/sitemap/JSON-LD so preview
# and localhost hosts cannot leak.
NEXT_PUBLIC_SITE_URL=https://www.opopa-partners.com

# Optional — reserved for a future GA4 integration. Not read by the app today.
# If added later, set on Production only and update the privacy policy first.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required — Resend API key. Server-side only. Never prefix with NEXT_PUBLIC_.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional — sender shown in outbound mail.
# Until the OPOPA sending domain is verified in Resend, leave unset to use Resend's test sender.
# After verifying the domain, set for example:
#   RESEND_FROM_EMAIL=OPOPA Partners <contact@opopa-partners.com>
RESEND_FROM_EMAIL=contact@opopa-partners.com

# Optional — internal notification inbox. Defaults to the current public contact address.
CONTACT_NOTIFICATION_EMAIL=raphaellevy027@gmail.com

# Insights CMS — Google service account (server-side only, never NEXT_PUBLIC_).
# Share the Blog Index spreadsheet and the CMS Drive folder with this email as Viewer.
GOOGLE_PROJECT_ID=opopa-blog-cms
GOOGLE_CLIENT_EMAIL=opopa-blog-reader@opopa-blog-cms.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_BLOG_SHEET_ID=1zTBna6kFxYhJ3TUwLmfNcMjoZ6vzg4oL-QA4w2ZsxX4
GOOGLE_BLOG_SHEET_NAME=Blog Index

# Optional — POST /api/insights/revalidate with Authorization: Bearer <secret>
# to refresh Insights immediately after publishing.
# INSIGHTS_REVALIDATE_SECRET=
