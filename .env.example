# Public
NEXT_PUBLIC_SITE_URL=https://www.opopa-partners.com

# Required — Resend API key. Server-side only. Never prefix with NEXT_PUBLIC_.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional — sender shown in outbound mail.
# Until opopa-partners.com is verified in Resend, leave unset to use Resend's test sender:
#   OPOPA <beth.t@example.com>
# After verifying the OPOPA domain, set:
#   RESEND_FROM_EMAIL=OPOPA <contact@opopa-partners.com>
RESEND_FROM_EMAIL=

# Optional — internal notification inbox. Defaults to the current OPOPA contact address.
CONTACT_NOTIFICATION_EMAIL=raphaellevy027@gmail.com
