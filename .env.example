# Public
NEXT_PUBLIC_SITE_URL=https://www.civep.com

# Required — Resend API key. Server-side only. Never prefix with NEXT_PUBLIC_.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional — sender shown in outbound mail.
# Until civep.com is verified in Resend, leave unset to use Resend's test sender:
#   CIVEP <beth.t@example.com>
# After verifying the CIVEP domain, set:
#   RESEND_FROM_EMAIL=CIVEP <contact@civep.com>
RESEND_FROM_EMAIL=

# Optional — internal notification inbox. Defaults to the current CIVEP contact address.
CONTACT_NOTIFICATION_EMAIL=raphaellevy027@gmail.com
